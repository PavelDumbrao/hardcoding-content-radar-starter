# Здесь только НАЗВАНИЯ настроек без реальных секретов.
# Скопируй этот файл в .env и впиши свои значения. Файл .env в git не попадает.

# --- База данных (можно оставить как есть для локального запуска) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar

# --- Модель (любой OpenAI-совместимый endpoint) ---
# Примеры base_url:
#   OpenAI        https://api.openai.com/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   свой LiteLLM  http://litellm:4000/v1
# Модель указывай ту, которая есть у твоего провайдера и умеет вызывать инструменты.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Источники ---
# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=
# VK: токен пользователя с доступом к video
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# --- Instagram через Apify ---
# Токен: Apify Console → API & Integrations
# APIFY_MAX_CHARGE_USD — жёсткий потолок расходов на один запуск (результаты платные).
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_SYNC_TIMEOUT=240
APIFY_MAX_CHARGE_USD=0.5

# --- Приложение ---
ENVIRONMENT=local
MAX_RESULTS=25

# --- Только для деплоя на сервер (docker-compose.prod.yml) ---
# Домен, на который будет отвечать сервис
APP_DOMAIN=radar.example.com
# Внешняя docker-сеть, где живёт reverse-proxy (Traefik)
TRAEFIK_NETWORK=traefik
# Имя резолвера сертификатов в Traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Подсеть стека: нужна на серверах, где у Docker закончились свободные адреса
STACK_SUBNET=10.247.0.0/24
